e,"sameSite":"None"},{"name":"KC_AUTH_SESSION_HASH","value":"REDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDRE","path":"/realms/assertion-desk/","expires":"2026-08-16T06:55:52.537Z","secure":true,"sameSite":"None"},{"name":"KC_RESTART","value":"REDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDRED..REDACTEDREDACTED..REDACTEDREDACTEDREDACT","path":"/realms/assertion-desk/","secure":true,"httpOnly":true,"sameSite":"None"}],"headers":[{"name":"Cache-Control","value":"no-store, must-revalidate, max-age=0"},{"name":"Content-Language","value":"en"},{"name":"Content-Type","value":"text/html;charset=utf-8"},{"name":"Set-Cookie","value":"AUTH_SESSION_ID=REDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDA;Version=1;Path=/realms/assertion-desk/;Secure;HttpOnly;SameSite=None"},{"name":"Set-Cookie","value":"KC_AUTH_SESSION_HASH=REDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDRE;Version=1;Path=/realms/assertion-desk/;Max-Age=60;Secure;SameSite=None"},{"name":"Set-Cookie","value":"KC_RESTART=REDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDRED..REDACTEDREDACTED..REDACTEDREDACTEDREDACT;Version=1;Path=/realms/assertion-desk/;Secure;HttpOnly;SameSite=None"},{"name":"content-length","value":"7121"}],"content":{"size":7121,"mimeType":"text/html;charset=utf-8","compression":0,"text":"<!DOCTYPE html>\n<html class=\"login-pf\" lang=\"en\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n    <title>Sign in to assertion-desk</title>\n        <link rel=\"icon\" href=\"/resources/q6q3p/login/keycloak.v2/img/favicon.ico\" />\n        <link href=\"/resources/q6q3p/common/keycloak/vendor/patternfly-v5/patternfly.min.css\" rel=\"stylesheet\" />\n        <link href=\"/resources/q6q3p/common/keycloak/vendor/patternfly-v5/patternfly-addons.css\" rel=\"stylesheet\" />\n        <link href=\"/resources/q6q3p/login/keycloak.v2/css/styles.css\" rel=\"stylesheet\" />\n    <script type=\"importmap\">\n        {\n            \"imports\": {\n                \"rfc4648\": \"/resources/q6q3p/common/keycloak/vendor/rfc4648/rfc4648.js\"\n            }\n        }\n    </script>\n      <script type=\"module\" async blocking=\"render\">\n          const DARK_MODE_CLASS = \"pf-v5-theme-dark\";\n          const mediaQuery = window.matchMedia(\"(prefers-color-scheme: dark)\");\n\n          updateDarkMode(mediaQuery.matches);\n          mediaQuery.addEventListener(\"change\", (event) => updateDarkMode(event.matches));\n\n          function updateDarkMode(isEnabled) {\n            const { classList } = document.documentElement;\n\n            if (isEnabled) {\n              classList.add(DARK_MODE_CLASS);\n            } else {\n              classList.remove(DARK_MODE_CLASS);\n            }\n          }\n      </script>\n    <script type=\"module\" src=\"/resources/q6q3p/login/keycloak.v2/js/passwordVisibility.js\"></script>\n    <script type=\"module\">\n        import { startSessionPolling } from \"/resources/q6q3p/login/keycloak.v2/js/authChecker.js\";\n\n        startSessionPolling(\n            \"/realms/assertion-desk/login-actions/restart?client_id=http%3A%2F%2F127.0.0.1%3A9091%2Fsaml%2Fmetadata&tab_id=oDW9f18bKq4&client_data=eyJydSI6Imh0dHA6Ly8xMjcuMC4wLjE6OTA5MS9zYW1sL2FjcyIsInJ0IjoiT05FTE9HSU5fODliNDllZDkyYmMxMmRkMzU5Mzk3MzA3NzIxZjRhZTNhMGJlZDYzNyIsInJtIjoicG9zdCIsInN0IjoiaHR0cDovLzEyNy4wLjAuMTo5MDkxL3NhbWwvbG9naW4ifQ&skip_logout=true\"\n        );\n    </script>\n    <script type=\"module\">\n        document.addEventListener(\"click\", (event) => {\n            const link = event.target.closest(\"a[data-once-link]\");\n\n            if (!link) {\n                return;\n            }\n\n            if (link.getAttribute(\"aria-disabled\") === \"true\") {\n                event.preventDefault();\n                return;\n            }\n\n            const { disabledClass } = link.dataset;\n\n            if (disabledClass) {\n                link.classList.add(...disabledClass.trim().split(/\\s+/));\n            }\n\n            link.setAttribute(\"role\", \"link\");\n            link.setAttribute(\"aria-disabled\", \"true\");\n        });\n    </script>\n        <script type=\"module\">\n            import { checkAuthSession } from \"/resources/q6q3p/login/keycloak.v2/js/authChecker.js\";\n\n            checkAuthSession(\n                REDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDREDACTEDRE\n            );\n        </script>\n    <script>\n      // Workaround for https://bugzilla.mozilla.org/show_bug.cgi?id=1404468\n      const isFirefox = true;\n    </script>\n</head>\n\n<body id=\"keycloak-bg\" class=\"\" data-page-id=\"login-login\">\n<div class=\"pf-v5-c-login\">\n  <div class=\"pf-v5-c-login__container\">\n    <header id=\"kc-header\" class=\"pf-v5-c-login__header\">\n      <div id=\"kc-header-wrapper\"\n              class=\"pf-v5-c-brand\">assertion-desk</div>\n    </header>\n    <main class=\"pf-v5-c-login__main\">\n      <div class=\"pf-v5-c-login__main-header\">\n        <h1 class=\"pf-v5-c-title pf-m-3xl\" id=\"kc-page-title\"><!-- template: login.ftl -->\n\n        Sign in to your account\n\n</h1>\n      </div>\n      <div class=\"pf-v5-c-login__main-body\">\n\n\n<!-- template: login.ftl -->\n\n        <div id=\"kc-form\">\n          <div id=\"kc-form-wrapper\">\n                <form id=\"kc-form-login\" class=\"pf-v5-c-form pf-v5-u-w-100\" onsubmit=\"login.disabled = true; return true;\" action=\"http://127.0.0.1:8080/realms/assertion-desk/login-actions/authenticate?session_code=NvJ6j6h1pqulFdB6bbOaYejobCKvOYN8PrvXzFq4cDc&amp;execution=1a510b77-de49-47db-855e-5236716afda8&amp;client_id=http%3A%2F%2F127.0.0.1%3A9091%2Fsaml%2Fmetadata&amp;tab_id=oDW9f18bKq4&amp;client_data=eyJydSI6Imh0dHA6Ly8xMjcuMC4wLjE6OTA5MS9zYW1sL2FjcyIsInJ0IjoiT05FTE9HSU5fODliNDllZDkyYmMxMmRkMzU5Mzk3MzA3NzIxZjRhZTNhMGJlZDYzNyIsInJtIjoicG9zdCIsInN0IjoiaHR0cDovLzEyNy4wLjAuMTo5MDkxL3NhbWwvbG9naW4ifQ\" method=\"post\" novalidate=\"novalidate\">\n\n<div class=\"pf-v5-c-form__group\">\n    <div class=\"pf-v5-c-form__group-label pf-v5-u-pb-xs\">\n        <label for=\"username\" class=\"pf-v5-c-form__label\">\n        <span class=\"pf-v5-c-form__label-text\">\n                                        Username or email\n\n        </span>\n        </label>\n    </div>\n\n    <span class=\"pf-v5-c-form-control \">\n        <input id=\"username\" name=\"username\" value=\"\" type=\"text\" autocomplete=\"username\" autofocus\n                \n                aria-invalid=\"\"/>\n    </span>\n\n    <div id=\"input-error-container-username\">\n    </div>\n</div>\n\n\n<div class=\"pf-v5-c-form__group\">\n    <div class=\"pf-v5-c-form__group-label pf-v5-u-pb-xs\">\n        <label for=\"password\" class=\"pf-v5-c-form__label\">\n        <span class=\"pf-v5-c-form__label-text\">\n            Password\n        </span>\n        </label>\n    </div>\n\n    <div class=\"pf-v5-c-input-group\">\n      <div class=\"pf-v5-c-input-group__item pf-m-fill\">\n        <span class=\"pf-v5-c-form-control \">\n          <input id=\"password\" name=\"password\" value=\"\" type=\"password\" autocomplete=\"current-password\" \n                  aria-invalid=\"\"/>\n        </span>\n      </div>\n      <div class=\"pf-v5-c-input-group__item\">\n        <button class=\"pf-v5-c-button pf-m-control\" type=\"button\" aria-label=\"Show password\"\n                aria-controls=\"password\" data-password-toggle\n                data-icon-show=\"fa-eye fas\" data-icon-hide=\"fa-eye-slash fas\"\n                data-label-show=\"Show password\" data-label-hide=\"Hide password\" id=\"password-show-password\">\n        